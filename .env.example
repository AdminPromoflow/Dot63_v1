# Set these in the server environment. This example is not loaded automatically.
# For hosting without environment variables, use controller/config/database.local.example.php.
# Local XAMPP defaults exist only for the development database; production has no fallback.
DOT63_DB_HOST=localhost
DOT63_DB_PORT=3306
DOT63_DB_NAME=dot63
DOT63_DB_USER=root
DOT63_DB_PASSWORD=

# Stripe — use test keys locally and live keys only in HTTPS production
DOT63_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
DOT63_STRIPE_SECRET_KEY=sk_test_replace_me
DOT63_STRIPE_WEBHOOK_SECRET=whsec_replace_me


# SMTP: configure a NEW password after rotating the exposed credential.
DOT63_SMTP_HOST=smtp.hostinger.com
DOT63_SMTP_PORT=587
DOT63_SMTP_USERNAME=your-mailbox@example.com
DOT63_SMTP_PASSWORD=
DOT63_SMTP_FROM_EMAIL=your-mailbox@example.com
DOT63_SMTP_FROM_NAME=.63
