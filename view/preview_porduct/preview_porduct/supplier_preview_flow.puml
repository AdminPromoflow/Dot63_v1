@startuml SupplierPreviewFlow

title Preview del proveedor — carga, renderizado e interacciones

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequence {
  ArrowColor #334155
  ActorBorderColor #334155
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #475569
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F1F5F9
}

autonumber

actor Proveedor
boundary "Navegador / DOM" as Browser
control "SupplierPreviewApp" as App
control "PreviewApi" as Api
entity "PreviewStore" as Store
control "VariationsController" as Variations
control "PricesController" as Prices
collections "Renderizadores\nGallery · Images · Items · Artwork" as Renderers
database "Backend PHP" as Backend

== 3. Preparación de la aplicación ==

Proveedor -> Browser: Abrir preview.php?sku={SKU}
Browser -> Browser: Obtener versión del módulo desde la URL

group Carga paralela mediante Promise.all
  par API
    Browser -> Api: import preview_api.js?v={versión}
  else Estado
    Browser -> Store: import preview_store.js?v={versión}
  else Galería y recursos
    Browser -> Renderers: importar preview, images, items y artwork
  else Precio
    Browser -> Prices: import prices.js?v={versión}
  else Variaciones
    Browser -> Variations: import variations.js?v={versión}
  end
end

Browser -> App: new SupplierPreviewApp()
App -> App: Crear módulos e inyectar dependencias
App -> Browser: Vincular eventos Editar y Enviar
Browser -> App: init()
App -> Browser: Leer parámetro sku

alt El SKU no existe
  App -> Browser: showFatal("The product SKU is missing...")
else El SKU existe
  App -> Browser: setLoading(true)
  App -> App: Crear AbortController de carga

  == 4–5. Consulta y datos generales ==

  App -> Api: getSupplierPreview(sku, signal)
  Api -> Backend: Solicitar preview protegido por SKU
  Backend --> Api: payload o error
  Api --> App: payload

  alt Respuesta válida
    App -> Store: setProduct(payload)
    App -> Browser: renderProduct(payload)
    App -> Browser: Pintar datos, breadcrumbs, estado y checklist
    App -> Browser: Habilitar envío si permissions.can_submit

    == 6–8. Variaciones, recursos y precio ==

    App -> Variations: loadRoot(root_variation_id)

    loop Por cada nivel del árbol de variaciones
      Variations -> Api: Consultar opciones del nivel
      Api -> Backend: Solicitar datos de variación
      Backend --> Api: Variación y recursos
      Api --> Variations: Datos del nivel
      Variations -> Store: Guardar opciones y selección activa
      Variations -> App: renderSelectedPath()

      App -> Renderers: clear()
      App -> Store: getSelectedRows()
      Store --> App: Ruta seleccionada ordenada

      loop Por cada fila seleccionada
        App -> App: Eliminar imágenes e items duplicados
        App -> Renderers: Renderizar imágenes, items y artwork
      end

      App -> Renderers: Estado vacío y refresh de galería
      App -> App: Buscar el precio base más específico

      alt Existe una fuente de precios
        App -> Prices: render(precios normalizados)
        Prices -> Prices: Seleccionar rango y calcular resumen
      else No existen precios para la ruta
        App -> Prices: clear()
      end
    end

    Variations --> App: Árbol inicial listo

    == 9. Pantalla lista ==

    App -> Browser: setLoading(false)

  else Solicitud reemplazada
    Api --> App: AbortError
    App -> App: Ignorar silenciosamente
  else Error de carga
    Api --> App: Error
    App -> Browser: showFatal(mensaje, error == 401)
  end
end

== Interacciones posteriores ==

opt El proveedor cambia una variación
  Proveedor -> Browser: Seleccionar una opción
  Browser -> Variations: Manejar selección
  Variations -> Store: Actualizar ruta activa
  Variations -> App: renderSelectedPath()
  App -> Renderers: Reconstruir recursos de la ruta
  App -> Prices: Recalcular precio
end

alt Volver a editar
  Proveedor -> Browser: Clic en Editar
  Browser -> App: goBack()
  App -> Store: getSelectedRows()
  Store --> App: Variación más profunda seleccionada
  App -> Browser: location.assign(editor?sku&sku_variation)
else 10. Enviar para aprobación
  Proveedor -> Browser: Clic en Enviar
  Browser -> App: submitForApproval()

  alt permissions.can_submit
    App -> Browser: Deshabilitar botón y mostrar progreso
    App -> Api: submitForApproval(sku, signal)
    Api -> Backend: Enviar SKU a controller/products/product.php
    Backend --> Api: Resultado
    Api --> App: Resultado

    alt Envío confirmado
      App -> Store: status = "2"; can_submit = false
      App -> Browser: Mostrar estado Pendiente y ocultar botón
    else Fallo de validación o servidor
      App -> Browser: Mostrar error y requisitos faltantes
      App -> Browser: Volver a habilitar botón
    end
  else Producto no listo
    App -> App: No enviar
  end
end

@enduml
