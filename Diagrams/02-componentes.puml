@startuml dot63_componentes
title DOT63 - Diagrama de componentes

skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor Cliente
actor Proveedor
actor Administrador

package "Presentación" {
  component "Vistas PHP" as Views
  component "JavaScript del navegador" as BrowserJS
  component "CSS e imágenes" as Assets
}

package "Aplicación PHP" {
  component "Autenticación\nde clientes" as CustomerAuth
  component "Autenticación y perfil\nde proveedores" as SupplierAuth
  component "Catálogo y filtros" as Catalog
  component "Gestión de productos" as ProductControllers
  component "Carrito y checkout" as Cart
  component "Mensajes" as Messages
  component "Correo de aprobación" as Email
  component "Sesión PHP" as Session
}

package "Dominio / persistencia" {
  component "Customers" as CustomersModel
  component "Users / Suppliers" as UsersModel
  component "Products" as ProductsModel
  component "Categories / Groups" as ClassificationModels
  component "Variations / Items /\nImages / Prices" as DetailModels
  component "Jobs / Orders" as JobsModel
  component "Database (PDO)" as Database
}

database "MySQL\ndot63" as MySQL
cloud "Servidor SMTP" as SMTP
cloud "API PromoFlow" as PromoFlow

Cliente --> Views
Proveedor --> Views
Administrador --> Views
Views --> BrowserJS
Views --> Assets

BrowserJS --> CustomerAuth : JSON/HTTP
BrowserJS --> SupplierAuth : JSON/HTTP
BrowserJS --> Catalog : JSON/HTTP
BrowserJS --> ProductControllers : JSON/HTTP
BrowserJS --> Cart : JSON/HTTP
BrowserJS --> Messages : JSON/HTTP

CustomerAuth --> CustomersModel
SupplierAuth --> UsersModel
Catalog --> ProductsModel
Catalog --> ClassificationModels
ProductControllers --> ProductsModel
ProductControllers --> ClassificationModels
ProductControllers --> DetailModels
ProductControllers --> Email
Cart --> JobsModel
Messages --> UsersModel

CustomerAuth --> Session
SupplierAuth --> Session
Cart --> Session
Messages --> Session

CustomersModel --> Database
UsersModel --> Database
ProductsModel --> Database
ClassificationModels --> Database
DetailModels --> Database
JobsModel --> Database
Database --> MySQL : PDO/MySQL
Email --> SMTP : SMTP/TLS
Messages --> PromoFlow : HTTPS/JSON

@enduml
