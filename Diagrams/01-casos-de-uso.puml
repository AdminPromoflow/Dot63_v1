@startuml dot63_casos_de_uso
title DOT63 - Diagrama de casos de uso

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor Cliente
actor Proveedor
actor Administrador
actor "Servicio PromoFlow" as PromoFlow

rectangle "Plataforma DOT63" {
  usecase "Registrarse e\niniciar sesión" as UCAuth
  usecase "Explorar catálogo" as UCCatalogo
  usecase "Buscar y filtrar\nproductos" as UCBuscar
  usecase "Ver producto y\nseleccionar variantes" as UCDetalle
  usecase "Gestionar carrito" as UCCarrito
  usecase "Validar promoción" as UCPromo
  usecase "Finalizar compra" as UCCheckout

  usecase "Gestionar perfil\nde proveedor" as UCPerfil
  usecase "Crear y editar\nproductos" as UCProducto
  usecase "Gestionar variantes,\nartículos, imágenes y precios" as UCContenido
  usecase "Enviar producto\na aprobación" as UCEnviar
  usecase "Consultar casos y\nmensajes" as UCMensajes

  usecase "Revisar y aprobar\nproductos" as UCAprobar
  usecase "Administrar categorías\ny grupos" as UCClasificacion
}

Cliente --> UCAuth
Cliente --> UCCatalogo
Cliente --> UCBuscar
Cliente --> UCDetalle
Cliente --> UCCarrito
Cliente --> UCCheckout

UCBuscar .> UCCatalogo : <<extend>>
UCDetalle .> UCCatalogo : <<extend>>
UCCheckout .> UCCarrito : <<include>>
UCCheckout .> UCPromo : <<extend>>

Proveedor --> UCAuth
Proveedor --> UCPerfil
Proveedor --> UCProducto
Proveedor --> UCContenido
Proveedor --> UCEnviar
Proveedor --> UCMensajes

UCContenido .> UCProducto : <<include>>
UCEnviar .> UCProducto : <<include>>

Administrador --> UCAprobar
Administrador --> UCClasificacion
Administrador --> UCMensajes

PromoFlow --> UCMensajes

@enduml
